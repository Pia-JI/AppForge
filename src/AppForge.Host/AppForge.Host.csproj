<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AppForge.Host</RootNamespace>
    <ApplicationIcon>..\..\build\AppForge.ico</ApplicationIcon>
    <AssemblyName>AppForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppForge.Shared\AppForge.Shared.csproj" />
    <!-- 唯一的第三方包：WebView2 托管桥（运行时来自系统） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <!-- zip 导出（.NET Framework 自带） -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shell UI 内嵌进 exe（单文件交付），同时拷到输出目录便于开发期改文件即生效 -->
    <EmbeddedResource Include="wwwroot\**\*">
      <LogicalName>ui/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
